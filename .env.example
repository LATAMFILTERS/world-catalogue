# ═══════════════════════════════════════════════════════════════
# ELIMFILTERS Part Search Server - Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env for local development
# In Railway: set these as environment variables in the dashboard

# ── REQUIRED ──────────────────────────────────────────────────
# PostgreSQL connection string (Railway provides this automatically
# when you add a Postgres plugin, or set it manually for external DB)
DATABASE_URL=postgresql://user:password@host:port/database

# Server port (Railway sets PORT automatically, do not change)
PORT=8080

# ── OPTIONAL ──────────────────────────────────────────────────
NODE_ENV=production
