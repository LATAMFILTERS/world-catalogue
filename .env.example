# ═══════════════════════════════════════════════════════════════════════════
# ELIMFILTERS BACKEND - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development

# Database
# Si no está seteada, usa Railway por defecto
# Para Neon o Supabase, descomenta y actualiza:
# DATABASE_URL=postgresql://user:password@host/dbname

# Alternativa a DATABASE_URL con campos separados (usada por run_sql.js
# cuando DATABASE_URL no está seteada — deben estar las 5 o el script falla):
# PGHOST=your-db-host-here
# PGPORT=5432
# PGDATABASE=your-db-name-here
# PGUSER=your-db-user-here
# PGPASSWORD=your-db-password-here

# Segunda base de datos (Railway, legacy) — usada por varios scripts sueltos
# de auditoría/diagnóstico en la raíz del repo (audit_*.js, count_*.js,
# inspect_*.js, etc.) y por run_audit.py:
# LEGACY_DB_URL=postgresql://user:password@host:port/dbname

# Google Sheets (opcional para desarrollo)
GOOGLE_SHEET_ID=your-sheet-id-here
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}

# Central Omnichannel Conversation Protocol
# Governed response path for Facebook, Instagram, WhatsApp, LinkedIn and YouTube.
# Never commit a real key. Provision BOT_PROTOCOL_API_KEY through the hosting
# provider's managed secret store.
BOT_PROTOCOL_URL=https://part-search.elimfilters.com
BOT_PROTOCOL_API_KEY=your-bot-protocol-api-key-here
BOT_PROTOCOL_TIMEOUT_MS=8000

# WhatsApp explicit rollout override.
# When omitted, WhatsApp automatically prefers the central protocol whenever
# BOT_PROTOCOL_API_KEY is present. Set false only for controlled rollback.
# USE_CENTRAL_PROTOCOL=true

# Legacy/fallback LLM configuration
# Retained only for controlled rollback paths on channels that have not yet
# been provisioned with BOT_PROTOCOL_API_KEY. Governed production answers should
# use the central omnichannel protocol above.
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Instagram Business API (webhook: /api/instagram/webhook)
INSTAGRAM_VERIFY_TOKEN=your-webhook-verify-token-here
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token-here
INSTAGRAM_APP_SECRET=your-meta-app-secret-here
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id-here

# Microsoft 365 / Outlook Email Integration (OAuth 2.0 Client Credentials)
# Register app at: https://portal.azure.com > Azure AD > App registrations
# Emails are automatically routed by type:
#   - contact forms → info@elimfilters.com
#   - distributor applications → distribution_network@elimfilters.com
#   - chat escalations → support@elimfilters.com
#   - finance/orders → finance@elimfilters.com
#   - logistics → logistics@elimfilters.com
#   - solutions inquiries → solutions@elimfilters.com
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_CLIENT_SECRET=your-azure-client-secret-here
AZURE_TENANT_ID=your-azure-tenant-id-here

# Outlook SMTP (fallback method)
# For application passwords or service account SMTP access
# Only needed if Graph API fails (recommended to have configured)
OUTLOOK_SMTP_PASSWORD=your-outlook-app-password-here

# Admin & Security
ADMIN_KEY=your-admin-api-key-here
TURNSTILE_SECRET=your-cloudflare-turnstile-secret-here
