{
  "schema_version": "1.1.0",
  "mission": "Continuously sweep the complete engine, vehicle, equipment and industrial filtration ecosystem; discover verifiable developments; compare them with ELIMFILTERS existing knowledge; and propose new knowledge or reinforcement of existing knowledge without duplication. LinkedIn is an explicit weekly discovery/radar source: HERMES may use official company, OEM, technical-institution and industry LinkedIn posts to detect signals, but a LinkedIn post must never be treated as final technical evidence by itself. For every LinkedIn-origin signal, HERMES must follow the post or independently locate a primary or technically verifiable source such as an official product page, case study, technical bulletin, white paper, standard, regulatory document or recognized technical publication before creating a verified candidate. If no such corroborating source is found, retain the signal as INTERNAL_ONLY / unresolved intelligence and do not propose canonical Knowledge Center or catalogue changes.",
  "coverage_policy": "EXPANSIVE_NOT_CLOSED_LIST",
  "lookback_days": 7,
  "max_findings_per_group": 6,
  "knowledge_actions": [
    "CREATE_NEW",
    "UPDATE_REINFORCE",
    "NO_MATERIAL_CHANGE",
    "INTERNAL_ONLY"
  ],
  "content_destinations": [
    "CATALOGUE",
    "KNOWLEDGE_CENTER",
    "TECHNICAL_INTELLIGENCE",
    "TECHNOLOGY_WATCH",
    "STANDARDS",
    "OEM_APPLICATION_INTELLIGENCE",
    "INTERNAL_ONLY"
  ],
