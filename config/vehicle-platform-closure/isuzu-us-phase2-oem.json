{
  "schema_version": "2.0.0",
  "phase_id": "ISUZU_US_DIESEL_THREE_PHASE_CLOSURE",
  "market": "US",
  "make": "ISUZU",
  "year_from": 2000,
  "year_to": 2026,
  "purpose": "Close Isuzu USA diesel applications from 2000-2026 in three gated phases: OEM vehicle identity, OEM OE/OEN filters, then aftermarket resolution.",
  "stages": [
    {
      "id": "PHASE_1_DIESEL_VEHICLE_UNIVERSE",
      "objective": "Using Isuzu USA primary evidence only, identify every diesel commercial-truck model by model year and close exact diesel engine family, displacement, and relevant configuration.",
      "allowed_sources": [
        "ISUZU_COMMERCIAL_TRUCK_OF_AMERICA"
      ],
      "required_output": [
        "MODEL_YEAR",
        "SERIES",
        "MODEL",
        "FUEL_DIESEL",
        "ENGINE_FAMILY",
        "DISPLACEMENT",
        "CONFIGURATION",
        "SOURCE_URL",
        "EVIDENCE_STATUS"
      ],
      "prohibited_actions": [
        "GASOLINE_RESEARCH",
        "AFTERMARKET_LOOKUP",
        "MODEL_EQUIVALENCE_INFERENCE",
        "FILTER_PROMOTION"
      ]
    },
    {
      "id": "PHASE_2_DIESEL_OEM_FILTER_OEN",
      "objective": "For each Phase 1 verified diesel year/model/engine configuration, capture genuine Isuzu OE/OEN references by filter position exactly as published.",
      "required_positions": [
        "AIR_PRIMARY",
        "LUBE_PRIMARY",
        "FUEL_PRIMARY",
        "FUEL_SECONDARY",
        "FUEL_WATER_SEPARATOR",
        "CABIN_IF_EQUIPPED"
      ],
      "allowed_sources": [
        "ISUZU_COMMERCIAL_TRUCK_OF_AMERICA"
      ],
      "required_output": [
        "VERIFIED_VEHICLE_KEY",
        "FILTER_POSITION",
        "ISUZU_OE_OEN",
        "SOURCE_URL",
        "YEAR_ENGINE_SCOPE",
        "EVIDENCE_STATUS"
      ],
      "prohibited_actions": [
        "GASOLINE_RESEARCH",
        "DONALDSON_LOOKUP",
        "FLEETGUARD_LOOKUP",
        "OTHER_AFTERMARKET_LOOKUP",
        "MODEL_TO_MODEL_INHERITANCE"
      ]
    },
    {
      "id": "PHASE_3_AFTERMARKET_RESOLUTION",
      "objective": "Resolve every Phase 2 verified Isuzu OE/OEN through aftermarket in fixed order: Donaldson first, Fleetguard second if needed, then other manufacturers as corroboration.",
      "allowed_sources": [
        "DONALDSON",
        "FLEETGUARD",
        "MANN-FILTER",
        "BALDWIN",
        "WIX",
        "FRAM"
      ],
      "source_order": [
        "DONALDSON",
        "FLEETGUARD",
        "MANN-FILTER",
        "BALDWIN",
        "WIX",
        "FRAM"
      ],
      "required_output": [
        "VERIFIED_VEHICLE_KEY",
        "FILTER_POSITION",
        "ISUZU_OE_OEN",
        "DONALDSON_REFERENCE",
        "FLEETGUARD_REFERENCE",
        "SUPPORTING_REFERENCES",
        "ELIMFILTERS_BASE_DECISION",
        "EVIDENCE_STATUS"
      ],
      "prohibited_actions": [
        "GASOLINE_RESEARCH",
        "AFTERMARKET_DEFINING_OEM_SCOPE",
        "CROSS_REFERENCE_ONLY_FITMENT_PROMOTION"
      ]
    }
  ],
