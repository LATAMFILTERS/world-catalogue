{
  "schema_version": "1.0.0",
  "policy": {
    "specialized_engine_first": true,
    "generic_web_is_discovery_only": true,
    "cross_reference_does_not_establish_fitment": true,
    "exact_application_required_for_vehicle_promotion": true
  },
  "brands": [
    {
      "id": "isuzu_usa",
      "match": [
        "ISUZU",
        "ISUZU TRUCKS",
        "ISUZU COMMERCIAL TRUCK OF AMERICA"
      ],
      "role": "OEM_VEHICLE_AUTHORITY",
      "market": "US",
      "engines": [
        {
          "id": "isuzu_us_nseries",
          "type": "official_vehicle_catalog",
          "base_url": "https://www.isuzucv.com",
          "supports": [
            "platform_identity",
            "model_year",
            "engine_identity"
          ],
          "priority": 1
        }
      ]
    },
    {
      "id": "wix",
      "match": [
        "WIX",
        "WIX FILTERS",
        "MANN+HUMMEL WIX"
      ],
      "role": "FILTER_APPLICATION_AUTHORITY",
      "market": "US",
      "engines": [
        {
          "id": "wix_vehicle_lookup",
          "type": "official_vehicle_application_api",
          "base_url": "https://m.wixfilters.com",
          "endpoints": {
            "years": "/search/vehicleYears2?section={section}",
            "makes": "/search/YearMakes2?vehicleYear={year}&section={section}",
            "models": "/search/MakeModels2?vehicleYear={year}&section={section}&make={make_id}",
            "engines": "/search/MakeEngines2?vehicleYear={year}&section={section}&make={make_id}&model={model_id}",
            "parts": "/search/SearchPartsByVehicle3?vehicleYear={year}&section={section}&make={make_id}&model={model_id}&engine={engine_id}"
          },
          "supports": [
            "vehicle_to_filter",
            "filter_position",
            "engine_specific_fitment"
          ],
          "priority": 1
        }
      ]
    },
    {
      "id": "mann_filter",
      "match": [
        "MANN",
        "MANN-FILTER",
        "MANN FILTER"
      ],
      "role": "FILTER_APPLICATION_AUTHORITY",
      "market": "GLOBAL",
      "engines": [
        {
          "id": "mann_online_catalog",
          "type": "official_online_catalog",
          "base_url": "https://www.mann-filter.com",
          "supports": [
            "product_lookup",
            "vehicle_to_filter",
            "oem_cross_reference"
          ],
          "priority": 1
        }
      ]
    },
    {
      "id": "donaldson",
      "match": [
        "DONALDSON"
      ],
      "role": "FILTER_APPLICATION_AUTHORITY",
      "market": "GLOBAL",
      "engines": [
        {
          "id": "donaldson_product_search",
          "type": "official_product_catalog",
          "base_url": "https://www.donaldson.com",
          "supports": [
            "product_lookup",
            "cross_reference",
            "application_lookup"
          ],
          "priority": 1
        }
      ]
    },
    {
      "id": "fleetguard",
      "match": [
        "FLEETGUARD",
        "CUMMINS FILTRATION"
      ],
      "role": "FILTER_APPLICATION_AUTHORITY",
      "market": "GLOBAL",
      "engines": [
        {
          "id": "fleetguard_product_search",
          "type": "official_product_catalog",
          "base_url": "https://www.fleetguard.com",
          "supports": [
            "product_lookup",
            "application_lookup",
            "cross_reference"
          ],
          "priority": 1
        }
      ]
    },
    {
      "id": "fram",
      "match": [
        "FRAM"
      ],
      "role": "FILTER_APPLICATION_AUTHORITY",
      "market": "US",
      "engines": [
        {
          "id": "fram_application_catalog",
          "type": "official_application_catalog",
          "base_url": "https://www.fram.com",
          "supports": [
            "vehicle_to_filter",
            "product_lookup"
          ],
          "priority": 1
        }
      ]
    },
    {
      "id": "baldwin",
      "match": [
        "BALDWIN"
      ],
      "role": "FILTER_APPLICATION_AUTHORITY",
      "market": "GLOBAL",
      "engines": [
        {
          "id": "baldwin_product_catalog",
          "type": "official_product_catalog",
          "base_url": "https://www.baldwinfilters.com",
          "supports": [
            "product_lookup",
            "application_lookup",
            "cross_reference"
          ],
          "priority": 1
        }
      ]
    },
    {
      "id": "parker_racor",
      "match": [
        "PARKER",
        "RACOR",
        "PARKER RACOR",
        "RACOR TURBINE"
      ],
      "role": "FILTER_APPLICATION_AUTHORITY",
      "market": "GLOBAL",
      "engines": [
        {
          "id": "parker_racor_turbine_search",
          "type": "official_product_catalog",
          "base_url": "https://www.parker.com",
          "supports": [
            "product_lookup",
            "cross_reference",
            "application_lookup",
            "turbine_compatibility"
          ],
          "priority": 1
        }
      ]
    }
  ]
}
