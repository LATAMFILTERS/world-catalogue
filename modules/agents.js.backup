// ═════════════════════════════════════════════════════════
// AGENTE 7: NORMALIZADOR TÉCNICO
// ═════════════════════════════════════════════════════════
class Agente7_Normalizador {
  normalize(scraperData) {
    // Asegurar que todas las medidas estén presentes
    const specs = scraperData.specs || {};
    
    // Convertir mm a inch si falta
    if (specs['Height (mm)'] && !specs['Height (inch)']) {
      specs['Height (inch)'] = (specs['Height (mm)'] / 25.4).toFixed(2);
    }
    
    if (specs['Outer Diameter (mm)'] && !specs['Outer Diameter (inch)']) {
      specs['Outer Diameter (inch)'] = (specs['Outer Diameter (mm)'] / 25.4).toFixed(2);
    }
    
    scraperData.specs = specs;
    return scraperData;
  }
}

// ═════════════════════════════════════════════════════════
// AGENTE 8: ARQUITECTO DE SKU
// ═════════════════════════════════════════════════════════
class Agente8_ArquitectoSKU {
  generate(masterCode, category) {
    const categoryMap = {
      'Lube': config.PREFIXES.OIL,
      'Air': config.PREFIXES.AIR,
      'Fuel': config.PREFIXES.FUEL,
      'Hydraulic': config.PREFIXES.HYDRAULIC,
      'Cabin': config.PREFIXES.CABIN
    };
    
    const prefix = categoryMap[category] || config.PREFIXES.OIL;
    const cleanCode = String(masterCode).replace(/[^0-9]/g, '');
    const last4 = cleanCode.length >= 4 
      ? cleanCode.slice(-4) 
      : cleanCode.padStart(4, '0');
    
    return prefix + last4;
  }
}

// ═════════════════════════════════════════════════════════
// AGENTE 9: INYECTOR DE ADN
// ═════════════════════════════════════════════════════════
class Agente9_InyectorADN {
  inject(category) {
    const tech = config.TECHNOLOGIES[category] || 'SINTRAX™';
    return {
      technology: tech,
      description: `${tech} ${category} Filter`
    };
  }
}

// ═════════════════════════════════════════════════════════
// AGENTE 10: MATCHER DE KITS
// ═════════════════════════════════════════════════════════
class Agente10_MatcherKits {
  constructor(db) {
    this.collection = db.collection(config.COLLECTIONS.MASTER_KITS);
  }
  
  async findKits(filterSKU) {
    return await this.collection.find({
      filters_included: filterSKU
    }).toArray();
  }
}

// ═════════════════════════════════════════════════════════
// AGENTE 11: ESCRITOR MONGODB
// ═════════════════════════════════════════════════════════
class Agente11_EscritorMongo {
  constructor(db) {
    this.collection = db.collection(config.COLLECTIONS.SUPER_MAESTRO);
  }
  
  async save(filterData) {
    const result = await this.collection.insertOne(filterData);
    return result.insertedId;
  }
  
  async update(sku, data) {
    return await this.collection.updateOne(
      { 'ELIMFILTERS SKU': sku },
      { $set: data }
    );
  }
}

