const config = require('./config');

// ═════════════════════════════════════════════════════════
// AGENTE 1: LIMPIADOR DE CÓDIGOS
// ═════════════════════════════════════════════════════════
class Agente1_Limpiador {
  clean(code) {
    if (!code) return '';
    return String(code)
      .toUpperCase()
      .replace(/[^A-Z0-9]/g, '')
      .trim();
  }
}

// ═════════════════════════════════════════════════════════
// AGENTE 2: CONSULTOR MASTER (Cache)
// ═════════════════════════════════════════════════════════
class Agente2_ConsultorMaster {
  constructor(db) {
    this.collection = db.collection(config.COLLECTIONS.SUPER_MAESTRO);
  }
  
  async findByCode(code) {
    // Buscar en Master Code
    let result = await this.collection.findOne({ 'Master Code': code });
    if (result) return { hit: true, data: result };
    
    // Buscar en Cross Reference
    result = await this.collection.findOne({ 'Cross Reference (AI)': code });
    if (result) return { hit: true, data: result };
    
    // Buscar en OEM Codes
    result = await this.collection.findOne({ 'OEM Codes (AH)': code });
    if (result) return { hit: true, data: result };
    
    return { hit: false, data: null };
  }
}

// ═════════════════════════════════════════════════════════
// AGENTE 3: PROMPT ENGINEER (Clasificador de Duty)
// ═════════════════════════════════════════════════════════
class Agente3_PromptEngineer {
  async classifyDuty(code, context = {}) {
    // VERSIÓN SIMPLIFICADA - Sin GROQ por ahora
    // Clasificación basada en patrones de código
    
    const codeUpper = code.toUpperCase();
    
    // Patrones HD (Donaldson, Fleetguard HD)
    const hdPatterns = [
      /^P\d{6}$/,      // Donaldson: P551808
      /^DBL\d{4}$/,    // Donaldson Blue
      /^LF\d{4}$/,     // Fleetguard Lube
      /^AF\d{5}$/,     // Fleetguard Air
      /^FF\d{4,5}$/,   // Fleetguard Fuel
      /^HF\d{4,5}$/    // Fleetguard Hydraulic
    ];
    
    for (const pattern of hdPatterns) {
      if (pattern.test(codeUpper)) {
        return 'HD';
      }
    }
    
    // Patrones LD (FRAM, WIX automotriz)
    const ldPatterns = [
      /^PH\d{4}$/,     // FRAM Oil
      /^CA\d{4,5}$/,   // FRAM Air
      /^G\d{4,5}$/,    // FRAM Fuel
      /^CF\d{5}$/      // FRAM Cabin
    ];
    
    for (const pattern of ldPatterns) {
      if (pattern.test(codeUpper)) {
        return 'LD';
      }
    }
    
    // Por defecto HD si no se detecta
    return 'HD';
  }
}

// ═════════════════════════════════════════════════════════
// AGENTE 4: BIFURCADOR
// ═════════════════════════════════════════════════════════
class Agente4_Bifurcador {
  route(duty) {
    return duty === 'HD' ? 'DONALDSON' : 'FRAM';
  }
}

