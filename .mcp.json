{
  "mcpServers": {
    "21st-magic": {
      "type": "http",
      "url": "https://mcp.21st.dev/api/mcp?apiKey=a810ca9493c2d356a5dcda020f0f05edd04dc91b7f82043567915bf61a3f74c4"
    },
    "nano-banana": {
      "command": "npx",
      "args": ["nano-banana-mcp"],
      "description": "Google Gemini-powered image generation for component mockups",
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "stitch": {
      "command": "npx",
      "args": ["@_davideast/stitch-mcp", "proxy"],
      "description": "Google Stitch design platform integration for component validation",
      "env": {
        "STITCH_API_KEY": "${STITCH_API_KEY}"
      }
    }
  }
}
