{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elimfilters.com/schemas/product-master.schema.json",
  "title": "ELIMFILTERS Product Master",
  "type": "object",
  "required": [
    "sku",
    "segment",
    "family",
    "construction",
    "technical_source",
    "production",
    "media"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 2
    },
    "segment": {
      "enum": [
        "HD",
        "LD"
      ]
    },
    "family": {
      "type": "string"
    },
    "construction": {
      "type": "string"
    },
    "technology": {
      "type": [
        "string",
        "null"
      ]
    },
    "technology_descriptor": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_geometry": {
      "type": [
        "object",
        "null"
      ]
    },
    "technical_source": {
      "type": "object",
      "required": [
        "source",
        "verified"
      ],
      "properties": {
        "source": {
          "const": "world_catalogue.elimfilters_catalog"
        },
        "verified": {
          "type": "boolean"
        },
        "height_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "outer_diameter_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "thread": {
          "type": [
            "string",
            "null"
          ]
        },
        "gasket": {
          "type": [
            "object",
            "null"
          ]
        },
        "crossrefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "verified"
            ],
            "properties": {
              "brand": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "production": {
      "type": "object",
      "required": [
        "template_id",
        "printable_area",
        "factory_ready"
      ],
      "properties": {
        "template_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "printable_area": {
          "type": "object",
          "properties": {
            "height_mm": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "circumference_mm": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            }
          }
        },
        "qr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "factory_ready": {
          "type": "boolean"
        }
      }
    },
    "lithography": {
      "type": "object"
    },
    "media": {
      "type": "object",
      "required": [
        "geometry_locked",
        "real_source_image_required",
        "approved_master_image"
      ],
      "properties": {
        "geometry_locked": {
          "const": true
        },
        "real_source_image_required": {
          "const": true
        },
        "synthetic_geometry_reference_forbidden": {
          "const": true
        },
        "official_logo_asset_required": {
          "type": "string"
        },
        "approved_master_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_master_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "explicit_user_image_approval_required": {
          "type": "boolean"
        },
        "approval_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "binary_persistence_status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "gate": {
      "type": "object"
    }
  }
}
