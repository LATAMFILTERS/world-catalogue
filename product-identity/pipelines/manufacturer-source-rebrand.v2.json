{
  "schema_version": "2.8",
  "pipeline_id": "ELIMFILTERS_MANUFACTURER_SOURCE_REBRAND",
  "status": "ACTIVE",
  "fail_closed": true,
  "text_to_image_allowed": false,
  "single_executor": {
    "required": true,
    "script": "product-identity/scripts/prepare-product-render.mjs",
    "output": "ELIMFILTERS_AUTHORIZED_RENDER_PACKET",
    "rule": "NO_RENDER_OR_CHAT_IMAGE_TOOL_CALL_WITHOUT_A_CURRENT_PASS_PACKET",
    "ad_hoc_prompt_values_forbidden": true,
    "remembered_sku_forbidden": true,
    "remembered_colors_forbidden": true,
    "remembered_technology_forbidden": true
  },
  "execution_scope": {
    "applies_to_all_skus": true,
    "applies_to_all_positions": true,
    "manual_screenshot_required": false,
    "automated_source_acquisition_required": true,
    "automated_source_script": "product-identity/scripts/acquire-manufacturer-source.mjs",
    "transient_http_retry_required": true,
    "same_manufacturer_official_page_fallback_allowed": true,
    "cross_manufacturer_fallback_forbidden": true,
    "cache_forbidden": true,
    "previous_render_as_geometry_source_forbidden": true,
    "image_generation_tool_call_forbidden_until_authorized_packet_passes": true
  },
  "source_evidence_gate": {
    "required": true,
    "requested_page_must_be_official_manufacturer_host": true,
    "resolved_page_must_be_official_manufacturer_host": true,
    "resolved_page_must_contain_current_part_number": true,
    "official_source_image_must_be_resolved_from_current_official_manufacturer_page": true,
    "official_source_image_artifact_must_exist": true,
    "official_source_image_sha256_required": true,
    "automated_screenshot_is_best_effort_audit_evidence": true,
    "automated_screenshot_is_not_a_render_gate": true,
    "transient_408_429_500_502_503_504_may_retry_or_fallback": true,
    "forbid_generic_spin_on_substitution": true,
    "forbid_geometry_from_previous_sku": true,
    "failure_action": "STOP_BEFORE_IMAGE_TOOL_CALL"
  },
  "database": {
    "table": "world_catalogue.elimfilters_catalog",
    "resolver": "product-identity/scripts/resolve-competitor-sku.mjs",
    "exact_match_count": 1,
    "fallback_allowed": false,
    "remembered_value_allowed": false
  },
  "artwork": {
    "container_hex": "#414141",
    "lithography_hex": "#CBCBCB",
    "logo": "frontend/public/assets/logo-elimfilters.png",
    "technology_directory": "frontend/public/assets/",
    "claim": "TOTAL ASSET PROTECTION",
    "descriptor": "Powered Filtration",
    "manufacturer_white_allowed": false,
    "secondary_print_colors_allowed": false,
    "german_quality_allowed": false,
    "arbitrary_technical_characters_allowed": false
  },
  "render_packet_required_fields": [
    "source.official_image_path",
    "source.official_image_sha256",
    "identity.elimfilters_sku",
    "identity.filter_type",
    "identity.technology",
    "identity.technology_asset_path",
    "identity.logo_asset_path",
    "artwork_lock.body_color_hex",
    "artwork_lock.lithography_color_hex",
    "geometry_lock.source_of_truth"
  ],
  "mandatory_chain": [
    "CURRENT_OFFICIAL_MANUFACTURER_PAGE",
    "AUTOMATED_OFFICIAL_SOURCE_ACQUISITION",
    "OFFICIAL_SOURCE_IMAGE_HASH",
    "LIVE_DATABASE_LOOKUP",
    "SKU_RESOLVED",
    "FILTER_TYPE_RESOLVED",
    "TECHNOLOGY_RESOLVED",
    "OFFICIAL_ASSETS_HASHED",
    "AUTHORIZED_RENDER_PACKET_PASS",
    "SOURCE_REFERENCED_RENDER",
    "POST_RENDER_VALIDATION",
    "USER_APPROVAL",
    "SAVE_JSON_AND_MASTER",
    "STORE_APPROVED_RENDER"
  ],
  "presentation_rule": "Rejected renders must not be presented as candidates.",
  "operator_rule": "For every SKU, execute prepare-product-render.mjs first. Values may only come from its PASS packet. If the packet is absent or stale, do not call any image generator."
}
