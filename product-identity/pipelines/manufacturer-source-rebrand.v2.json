{
  "schema_version": "2.6",
  "pipeline_id": "ELIMFILTERS_MANUFACTURER_SOURCE_REBRAND",
  "status": "ACTIVE",
  "fail_closed": true,
  "text_to_image_allowed": false,
  "execution_scope": {
    "applies_to_all_skus": true,
    "applies_to_all_positions": true,
    "rule": "NO_RENDER_WITHOUT_VERIFIED_FRESH_OFFICIAL_SOURCE_IMAGE",
    "manual_screenshot_required": false,
    "automated_source_acquisition_required": true,
    "automated_source_script": "product-identity/scripts/acquire-manufacturer-source.mjs",
    "cache_forbidden": true,
    "previous_render_as_geometry_source_forbidden": true,
    "image_generation_tool_call_forbidden_until_source_gate_passes": true
  },
  "source_evidence_gate": {
    "required": true,
    "product_page_must_be_official_manufacturer_host": true,
    "product_page_must_contain_current_part_number": true,
    "official_source_image_must_be_resolved_from_current_product_page": true,
    "official_source_image_artifact_must_exist": true,
    "official_source_image_sha256_required": true,
    "automated_screenshot_created_for_audit": true,
    "automated_screenshot_is_not_a_manual_gate": true,
    "geometry_signature_must_be_recorded_before_render": true,
    "geometry_signature_required_fields": [
      "overall_body_proportions",
      "upright_horizontal_composition",
      "top_rim_geometry",
      "baseplate_or_open_end_type",
      "thread_geometry",
      "gasket_geometry",
      "inlet_hole_or_support_pattern",
      "central_support_or_perforation_pattern"
    ],
    "forbid_generic_spin_on_substitution": true,
    "forbid_geometry_from_previous_sku": true,
    "failure_action": "STOP_BEFORE_IMAGE_TOOL_CALL"
  },
  "lineage_verification": {
    "mode": "APPLICATION_VERIFIED",
    "engine_edit_op_is_authoritative": false,
    "engine_edit_op_null_is_not_a_reject_by_itself": true,
    "required_evidence": [
      "CURRENT_SKU_SOURCE_EVIDENCE_PATH",
      "CURRENT_SKU_OFFICIAL_IMAGE_SHA256",
      "MANUFACTURER_AND_PART_NUMBER_BINDING",
      "RECORDED_SOURCE_GEOMETRY_SIGNATURE",
      "LIVE_DATABASE_RESOLUTION_RESULT",
      "RESOLVED_TECHNOLOGY",
      "RESOLVED_OFFICIAL_ASSETS",
      "OUTPUT_GEN_ID",
      "POST_RENDER_GEOMETRY_MATCH_PASS",
      "POST_RENDER_ARTWORK_MATCH_PASS"
    ]
  },
  "preflight": {
    "required": true,
    "script": "product-identity/scripts/preflight-product-image.mjs",
    "required_result": {"manifest_status": "PASS", "image_generation_enabled": true},
    "must_execute_live_database_lookup": true,
    "must_execute_technology_asset_resolution": true,
    "must_validate_source_evidence_binding": true,
    "must_validate_geometry_signature": true
  },
  "manifest_builder": "product-identity/scripts/build-render-manifest.mjs",
  "hard_render_gates": "product-identity/pipelines/render-hard-gates.v1.json",
  "state_machine": ["SOURCE_LOCKED","GEOMETRY_APPROVED","PAINT_LITHO_APPROVED","FINAL_APPROVED"],
  "mandatory_chain": [
    "MANUFACTURER_CATEGORY_OR_PRODUCT_PAGE",
    "CURRENT_SKU_OFFICIAL_PRODUCT_PAGE",
    "AUTOMATED_OFFICIAL_SOURCE_ACQUISITION",
    "OFFICIAL_SOURCE_IMAGE_ARTIFACT_EXISTS",
    "OFFICIAL_SOURCE_IMAGE_SHA256_RECORDED",
    "FRESH_SOURCE_NO_CACHE_PASS",
    "AUTOMATED_AUDIT_SCREENSHOT_RECORDED",
    "GEOMETRY_SIGNATURE_RECORDED",
    "LIVE_DATABASE_LOOKUP",
    "SKU_RESOLVED",
    "FILTER_TYPE_RESOLVED",
    "TECHNOLOGY_RESOLVED",
    "OFFICIAL_ASSETS_RESOLVED",
    "PREFLIGHT_PASS",
    "PHASE_1",
    "USER_APPROVAL",
    "PHASE_2",
    "USER_APPROVAL",
    "PHASE_3",
    "USER_APPROVAL",
    "APPLICATION_LINEAGE_EVIDENCE_RECORDED",
    "SAVE_JSON_AND_MASTER",
    "STORE_APPROVED_RENDER"
  ],
  "database": {
    "table": "world_catalogue.elimfilters_catalog",
    "resolver": "product-identity/scripts/resolve-competitor-sku.mjs",
    "exact_match_count": 1,
    "fallback_allowed": false,
    "remembered_value_allowed": false
  },
  "artwork": {
    "container_hex": "#414141",
    "lithography_hex": "#CBCBCB",
    "logo": "frontend/public/assets/logo-elimfilters.png",
    "technology_directory": "frontend/public/assets/",
    "claim": "TOTAL ASSET PROTECTION",
    "descriptor": "Powered Filtration",
    "manufacturer_white_allowed_in_phase_2": false,
    "secondary_print_colors_allowed": false
  },
  "render_purity": {
    "validation_ui_must_never_appear_in_product_render": true,
    "manifest_text_must_never_appear_in_product_render": true,
    "database_text_must_never_appear_in_product_render": true,
    "source_urls_must_never_appear_in_product_render": true,
    "pipeline_status_text_must_never_appear_in_product_render": true,
    "manufacturer_branding_must_never_appear_in_phase_2_plus": true,
    "only_authorized_product_artwork_may_be_visible": true
  },
  "phase_1": {
    "mode": "GEOMETRY_ONLY",
    "requires_current_official_source_image": true,
    "requires_geometry_signature_match": true,
    "rebrand_allowed": false
  },
  "phase_2": {
    "mode": "PAINT_LITHOGRAPHY_ONLY",
    "requires_state": "GEOMETRY_APPROVED",
    "requires_approved_geometry_master": true,
    "body_color_required": "#414141",
    "lithography_color_required": "#CBCBCB",
    "manufacturer_white_body_is_hard_reject": true
  },
  "phase_3": {
    "mode": "MICRO_ADJUSTMENT_ONLY",
    "requires_state": "PAINT_LITHO_APPROVED",
    "single_view_requires_protected_opposite_view": true,
    "whole_composition_regeneration_allowed": false
  },
  "pre_tool_call_reject_if": [
    "OFFICIAL_PRODUCT_PAGE_MISSING",
    "OFFICIAL_PRODUCT_PAGE_PART_NUMBER_MISMATCH",
    "OFFICIAL_SOURCE_IMAGE_MISSING",
    "OFFICIAL_SOURCE_IMAGE_SKU_MISMATCH",
    "SOURCE_EVIDENCE_HASH_MISSING",
    "CACHE_OR_PREVIOUS_MASTER_USED",
    "GEOMETRY_SIGNATURE_MISSING",
    "GENERIC_SPIN_ON_GEOMETRY_SUBSTITUTION",
    "LIVE_DATABASE_LOOKUP_NOT_EXECUTED",
    "SKU_NOT_RESOLVED",
    "TECHNOLOGY_NOT_RESOLVED",
    "OFFICIAL_ASSETS_NOT_RESOLVED",
    "PREFLIGHT_NOT_PASS"
  ],
  "post_render_reject_if": [
    "APPLICATION_LINEAGE_EVIDENCE_MISSING",
    "SOURCE_BINDING_MISSING",
    "BODY_REMAINS_MANUFACTURER_WHITE",
    "BODY_NOT_414141_DARK_CHARCOAL",
    "LITHOGRAPHY_NOT_CBCBCB_SILVER",
    "SKU_MISMATCH",
    "TECHNOLOGY_MISMATCH",
    "GEOMETRY_DRIFT",
    "PROTECTED_VIEW_CHANGED",
    "COMPETITOR_BRANDING_PRESENT",
    "SECONDARY_COLORS_PRESENT",
    "VALIDATION_UI_PRESENT",
    "PIPELINE_TEXT_PRESENT"
  ],
  "presentation_rule": "Rejected renders must not be presented as candidates.",
  "operator_rule": "For every SKU, acquire a fresh verified official manufacturer image automatically from the current official product page. A manually supplied screenshot is not required. Never use cache or a prior render as geometry source."
}
