{
  "schema_version": "1.2",
  "pipeline_id": "ELIMFILTERS_MANUFACTURER_SOURCE_REBRAND",
  "status": "ACTIVE",
  "mode": "FAIL_CLOSED_SOURCE_IMAGE_EDIT_ONLY",
  "text_to_image_allowed": false,
  "synthetic_source_allowed": false,
  "simulated_screenshot_allowed": false,
  "state_machine": ["SOURCE_LOCKED", "GEOMETRY_APPROVED", "PAINT_LITHO_APPROVED", "FINAL_APPROVED"],
  "view_model": {
    "views": ["VERTICAL_VIEW", "HORIZONTAL_VIEW"],
    "independent_view_locks": true,
    "approved_view_becomes_protected_region": true,
    "whole_composition_regeneration_for_single_view_fix_allowed": false
  },
  "phase_1_geometry_only": {
    "requires_referenced_source_image": true,
    "rebrand_allowed": false,
    "recolor_allowed": false,
    "preserve": [
      "overall_shape", "height_to_diameter_ratio", "body_length", "top_opening_and_rim",
      "top_bottom_seams", "baseplate_geometry", "thread_geometry", "gasket_geometry",
      "inlet_hole_count", "inlet_hole_shape", "inlet_hole_positions", "construction_features",
      "perspective", "orientation", "relative_scale_between_views", "crop", "composition"
    ]
  },
  "phase_2_paint_lithography": {
    "prerequisite_state": "GEOMETRY_APPROVED",
    "must_edit_approved_geometry_master": true,
    "new_product_generation_allowed": false,
    "allowed_changes": ["container_surface_color", "authorized_lithography"],
    "mechanical_features_immutable": true,
    "container_color": {"hex": "#414141", "finish": "SEMI_MATTE_INDUSTRIAL_COATING"},
    "lithography_color": {"hex": "#CBCBCB", "finish": "METALLIC_SILVER_SATIN"}
  },
  "sku_continuity": {
    "resolved_once_per_target_product": true,
    "immutable_across_views_and_later_phases": true,
    "same_sku_required_on_vertical_and_horizontal": true,
    "reference_image_may_donate_sku": false,
    "previous_product_may_donate_sku": false,
    "remembered_sku_allowed": false,
    "reference_image_allowed_donations": ["typography", "spacing", "hierarchy", "placement"],
    "on_sku_mismatch_between_views": "REJECT_OUTPUT",
    "on_reference_sku_leak": "REJECT_OUTPUT"
  },
  "phase_3_micro_adjustments": {
    "prerequisite_state": "PAINT_LITHO_APPROVED",
    "scope_lock_required": true,
    "target_view_values": ["VERTICAL_ONLY", "HORIZONTAL_ONLY", "BOTH"],
    "localized_edit_mask_required_for_single_view": true,
    "protected_view_pixel_equivalence_required": true,
    "only_explicitly_requested_property_may_change": true,
    "cumulative_unsolicited_changes_allowed": false
  },
  "catalog_gate": {
    "required_before_phase_2": true,
    "source": "world_catalogue.elimfilters_catalog",
    "resolver": "product-identity/scripts/resolve-competitor-sku.mjs",
    "exact_match_count_required": 1,
    "infer_sku_allowed": false,
    "hardcoded_fallback_allowed": false
  },
  "required_assets": {
    "manufacturer_source_image": {"required": true, "must_be_physically_referenced_by_image_tool": true},
    "official_logo": {"required_for_phase_2_plus": true, "path": "frontend/public/assets/logo-elimfilters.png", "must_be_loaded_as_binary_asset": true},
    "technology_artwork": {"required_for_phase_2_plus": true, "directory": "frontend/public/assets/", "must_be_loaded_as_binary_asset": true}
  },
  "render_manifest": {
    "required_before_every_image_tool_call": true,
    "required_fields": [
      "phase", "competitor_code", "source_image_id_or_path", "active_target_view",
      "protected_views", "target_property", "edit_mask_or_scope", "immutable_elements",
      "allowed_changes", "RENDER_INPUTS_VERIFIED"
    ],
    "phase_2_plus_additional_fields": [
      "resolved_sku", "geometry_master_id_or_path", "official_logo_asset_path", "official_technology_asset_path"
    ],
    "single_view_edit_additional_fields": ["prior_approved_protected_view_master_id_or_path"],
    "render_inputs_verified_value": true,
    "missing_field_behavior": "STOP_RENDER_MANIFEST_INCOMPLETE"
  },
  "image_tool_enforcement": {
    "operation_must_be_edit": true,
    "referenced_image_lineage_required": true,
    "reject_when_source_lineage_missing": true,
    "reject_when_protected_view_changes": true,
    "reject_when_full_regeneration_used_for_single_view_fix": true,
    "never_present_rejected_output": true
  },
  "pre_display_qc": [
    "SOURCE_LINEAGE_MATCH", "BASEPLATE_MATCH", "THREAD_MATCH", "GASKET_MATCH",
    "HOLE_PATTERN_MATCH", "PROPORTIONS_MATCH", "PERSPECTIVE_MATCH", "COMPOSITION_MATCH",
    "SKU_MATCH_ON_BOTH_VIEWS", "NO_REFERENCE_SKU_LEAK", "LOGO_ASSET_MATCH",
    "TECHNOLOGY_ASSET_MATCH", "CHARCOAL_SILVER_ONLY", "NO_EXTRA_TEXT",
    "PROTECTED_VIEW_UNCHANGED", "ONLY_REQUESTED_PROPERTY_CHANGED"
  ],
  "failure_behavior": "STOP_AND_FLAG_FOR_REVIEW",
  "control_cases": {
    "LF670": "Geometry unique to LF670; never reuse for another SKU.",
    "LF3620": "Use exact LF3620 Fleetguard geometry. EL81670 imagery may guide style/layout only; EL81670 SKU must never appear on LF3620."
  }
}
