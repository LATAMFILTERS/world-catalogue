{
  "schema_version": "1.4",
  "status": "ACTIVE",
  "fail_closed": true,
  "pre_tool_call_required": [
    "CURRENT_SKU_OFFICIAL_PRODUCT_PAGE",
    "CURRENT_SKU_VERIFIED_OFFICIAL_SOURCE_IMAGE",
    "CURRENT_SKU_SOURCE_IMAGE_SKU_MATCH_PASS",
    "FRESH_SOURCE_NO_CACHE_PASS",
    "GEOMETRY_EXTRACTED_FROM_CURRENT_SOURCE",
    "LIVE_DATABASE_SKU_RESOLUTION",
    "FILTER_TYPE_RESOLUTION",
    "TECHNOLOGY_RESOLUTION",
    "OFFICIAL_LOGO_BINARY",
    "OFFICIAL_TECHNOLOGY_BINARY",
    "MANIFEST_PASS"
  ],
  "tool_call_block_rule": "IF any pre_tool_call_required gate != PASS THEN IMAGE_GENERATION_TOOL_CALL_FORBIDDEN",
  "source_gate": {
    "required_for_every_sku": true,
    "required_for_every_render_attempt": true,
    "primary_geometry_authority": "VERIFIED_OFFICIAL_MANUFACTURER_SOURCE_IMAGE",
    "manual_screenshot_required": false,
    "automated_screenshot_role": "AUDIT_EVIDENCE_ONLY",
    "manufacturer_host_must_match_current_sku": true,
    "product_page_must_contain_current_part_number": true,
    "official_image_must_be_resolved_from_current_product_page": true,
    "other_sku_source_forbidden": true,
    "cached_source_forbidden": true,
    "previous_render_as_geometry_source_forbidden": true,
    "geometry_must_be_derived_from_current_official_source_image": true
  },
  "lineage_gate": {
    "mode": "APPLICATION_VERIFIED",
    "engine_edit_op_required": false,
    "engine_edit_op_null_is_not_failure_by_itself": true,
    "required": [
      "CURRENT_SKU_SOURCE_EVIDENCE_REFERENCE",
      "CURRENT_SKU_OFFICIAL_IMAGE_HASH",
      "CURRENT_SKU_BINDING",
      "SOURCE_GEOMETRY_SIGNATURE",
      "LIVE_DATABASE_RESOLUTION_EVIDENCE",
      "RESOLVED_TECHNOLOGY_EVIDENCE",
      "OFFICIAL_ASSET_EVIDENCE",
      "OUTPUT_GEN_ID",
      "POST_RENDER_GEOMETRY_MATCH_PASS",
      "POST_RENDER_ARTWORK_MATCH_PASS"
    ]
  },
  "phase_2_required_values": {
    "container_color_hex": "#414141",
    "lithography_color_hex": "#CBCBCB",
    "render_mode": "SOURCE_REFERENCED_TRANSFORMATION",
    "competitor_branding_allowed": false,
    "secondary_colors_allowed": false,
    "validation_ui_allowed": false,
    "pipeline_text_allowed": false,
    "database_text_allowed": false,
    "source_url_text_allowed": false
  },
  "post_render_hard_rejects": [
    "APPLICATION_LINEAGE_EVIDENCE_MISSING",
    "SOURCE_BINDING_MISSING",
    "BODY_REMAINS_MANUFACTURER_WHITE",
    "BODY_NOT_414141_DARK_CHARCOAL",
    "LITHOGRAPHY_NOT_CBCBCB_SILVER",
    "SKU_MISMATCH",
    "TECHNOLOGY_MISMATCH",
    "GEOMETRY_DRIFT",
    "PROTECTED_VIEW_CHANGED",
    "COMPETITOR_BRANDING_PRESENT",
    "SECONDARY_COLORS_PRESENT",
    "VALIDATION_UI_PRESENT",
    "PIPELINE_TEXT_PRESENT",
    "DATABASE_TEXT_PRESENT",
    "SOURCE_URL_TEXT_PRESENT"
  ],
  "presentation_rule": "A rejected render must never be shown to the user as a candidate."
}
