# ═══════════════════════════════════════════════════════════════════
# ELIMFILTERS AI ENGINE - Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# Server
AI_ENGINE_PORT=3001
NODE_ENV=development

# Database (PostgreSQL - read-only access)
# Must be same as Search Server's DATABASE_URL
DATABASE_URL=postgresql://user:password@postgres-production-2529.up.railway.app:5432/railway

# GROQ API (Primary LLM Provider)
# Fast, cost-effective, supports tool calling
GROQ_API_KEY=gsk_your_groq_api_key_here

# Note: Models available in GROQ:
# - mixtral-8x7b-32768 (default, recommended)
# - llama-3-8b-instant
# - llama-3-70b-versatile
# - gemma-7b-it
