{
  "schemaVersion": "1.0",
  "service": "ELIMFILTERS public agent discovery",
  "status": "ACTIVE",
  "protocol": "informational-read-only",
  "dnsAidAdvertised": true,
  "agents": [
    {
      "id": "public-discovery",
      "name": "ELIMFILTERS public resource discovery",
      "protocol": "https",
      "endpoint": "https://elimfilters.com/.well-known/public-discovery-agent.json",
      "method": "GET",
      "mode": "read-only",
      "capabilities": [
        "list-public-resources"
      ],
      "public": true,
      "access": "anonymous",
      "dnsName": "_public-discovery._https._agents.elimfilters.com",
      "verifiedScope": "public documentation and catalog discovery; no product applications, CRM or internal tools"
    }
  ],
  "resources": [
    {
      "rel": "ai-catalog",
      "href": "https://elimfilters.com/.well-known/ai-catalog.json",
      "contentType": "application/json"
    },
    {
      "rel": "documentation",
      "href": "https://elimfilters.com/llms.txt",
      "contentType": "text/plain"
    }
  ],
  "policy": {
    "publicAgentEndpointsRequireIndependentVerification": true,
    "internalAgentsNotPublic": true,
    "automaticPublication": false,
    "applicationsWithoutVerifiedEvidenceExcluded": true,
    "crossReferencesDoNotEstablishCompatibility": true
  },
  "note": "Public HTTPS read-only discovery agent. DNS-AID TXT index and per-agent SVCB were verified with Google Public DNS: NOERROR, AD=true, TTL=300, on 2026-11-01. This static document does not offer MCP or A2A callable tools."
}
