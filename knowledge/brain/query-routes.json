      "optional_sources": ["graphify"],
      "minimum_evidence": "observed",
      "output_sensitivity": "public_safe",
      "required_disclosure": "assertion_level"
    },
    {
      "id": "equipment-application",
      "intents": ["equipment_lookup", "vehicle_lookup", "engine_lookup"],
      "required_sources": ["postgresql-catalogue"],
      "optional_sources": ["canonical-knowledge", "graphify"],
      "minimum_evidence": "application_record",
      "output_sensitivity": "public_safe",
      "prohibited_conclusions": ["fitment_without_source"]
    },
    {
      "id": "failure-intelligence",
      "intents": ["diagnose_risk", "failure_mode", "contamination_risk"],
