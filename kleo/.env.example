# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed. KLEO reads secrets ONLY from here / real
# environment variables — never from config.json.

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# The single Telegram chat_id KLEO will accept commands from. Required.
# Every other chat is silently rejected and logged as unauthorized.
TELEGRAM_AUTHORIZED_CHAT_ID=

# Path to the Claude Code executable. "claude" (on PATH) works if the CLI
# was installed normally; override with a full path otherwise.
CLAUDE_CODE_PATH=claude

# Optional overrides — leave blank to use the paths from config.json.
KLEO_PROJECT_WORLD=
KLEO_PROJECT_PHOENIX=
KLEO_PROJECT_MARKETING=
KLEO_PROJECT_COMMERCIAL=
KLEO_PROJECT_MCP=
KLEO_PROJECT_KLEO=
KLEO_PROJECT_ELIMFILTERS=

# Optional: SQLite DB / log file locations.
KLEO_DB_PATH=./data/kleo.db
KLEO_LOG_PATH=./data/kleo.log

# Optional MCP adapter credentials (only needed for adapters enabled in
# config.json). Never commit real values.
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
