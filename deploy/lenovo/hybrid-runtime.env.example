# Hybrid execution identity for the Lenovo world-catalogue node
ELIM_RUNTIME_NODE=LENOVO
ELIM_RUNTIME_ROLE=PRIMARY
ELIM_DOMAIN=WORLD_CATALOGUE
ELIM_SCHEDULER_ENABLED=true

# Cloud failover examples must use:
# ELIM_RUNTIME_NODE=RENDER
# ELIM_RUNTIME_ROLE=STANDBY
# ELIM_DOMAIN=WORLD_CATALOGUE
# ELIM_SCHEDULER_ENABLED=false
