# ELIMFILTERS world-catalogue — Lenovo private server
WORLD_CATALOGUE_HOST_PORT=3100
PORT=3000
NODE_ENV=production

# Required to publish this node publicly as part-search.elimfilters.com.
# Create the tunnel in Cloudflare Zero Trust > Networks > Tunnels, then
# point the part-search.elimfilters.com DNS record (CNAME) at
# <tunnel-id>.cfargotunnel.com and paste the tunnel token below.
# Without this, the container refuses to start as ELIM_RUNTIME_ROLE=PRIMARY.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Use the production catalogue database connection here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

BOT_PROTOCOL_URL=https://part-search.elimfilters.com
BOT_PROTOCOL_API_KEY=CHANGE_ME
BOT_PROTOCOL_TIMEOUT_MS=8000

HERMES_EMAIL_PROVIDER=outlook
HERMES_SENDER_EMAIL=hermes@elimfilters.com
HERMES_REVIEW_EMAIL=CHANGE_ME
HERMES_EMAIL_LIVE=false
HERMES_REVIEW_BASE_URL=https://elimfilters.com/hermes/review
HERMES_REVIEW_LINK_TTL_DAYS=14
HERMES_REVIEW_TOKEN_SECRET=CHANGE_ME

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
ADMIN_KEY=CHANGE_ME
TURNSTILE_SECRET=
