# ===== ELIMFILTERS Components Library Configuration =====

# Google Gemini API (for Nano-Banana-MCP visual generation)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Stitch API (for Stitch-MCP component composition)
# Requires OAuth setup via: npx @_davideast/stitch-mcp init
STITCH_API_KEY=your_stitch_api_key_here

# Development environment
NODE_ENV=development

# Optional: Design system output directory
DESIGN_SYSTEM_OUTPUT=./docs/DESIGN-SYSTEM.md

# Optional: Visual assets directory
VISUAL_ASSETS_PATH=./visual-assets
