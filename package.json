{
  "name": "elimfilters-search-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-safe.js && node --test tests/omnichannel-canonical-taxonomy.test.js tests/bot-protocol-postgres-rich-response.test.js",
    "start": "node server-protocol.js",
    "dev": "node server-protocol.js",
