    "test:ebp-phase2": "node --test tests/ebp-phase2/*.test.js",
    "test:ebp-phase3": "node --test tests/ebp-phase3/*.test.js",
    "test:ebp-phase4": "node --test tests/ebp-phase4/*.test.js",
    "test:ebp-phase5": "node --test tests/ebp-phase5/*.test.js",
    "test:ebp": "npm run test:ebp-phase1 && npm run test:ebp-phase2 && npm run test:ebp-phase3 && npm run test:ebp-phase4 && npm run test:ebp-phase5",
    "test:chatbot": "node --test tests/chatbot-routing-integration.test.js",
    "test:bot-protocol": "node --test tests/bot-protocol-guardrails.test.js tests/bot-protocol-catalog-research.test.js tests/bot-protocol-catalog.test.js tests/bot-protocol-memory.test.js tests/bot-protocol-orchestrator.test.js tests/bot-protocol-security.test.js tests/bot-protocol-unified-orchestrator.test.js tests/bot-protocol-escalation-sequence.test.js tests/bot-protocol-multichannel-contract.test.js tests/omnichannel-canonical-taxonomy.test.js tests/bot-protocol-postgres-rich-response.test.js",
    "test:bot-e2e": "node --test tests/bot-protocol-e2e.test.js",
    "test:knowledge-governance": "node --test tests/knowledge-governance-authority-policy.test.js tests/knowledge-governance-technical-evidence.test.js tests/knowledge-governance-oem-maintenance.test.js tests/knowledge-governance-knowledge-gap.test.js tests/knowledge-governance-hermes-research.test.js tests/knowledge-governance-hermes-domain-context.test.js tests/knowledge-governance-domain-registry.test.js tests/knowledge-governance-fram-corpus.test.js tests/knowledge-governance-automotive-synthesis.test.js tests/knowledge-governance-public-synthesis.test.js tests/knowledge-governance-obsidian-publication.test.js tests/knowledge-governance-sku-authority.test.js tests/knowledge-governance-response-governance.test.js tests/knowledge-governance-orchestrator-integration.test.js",
    "test:knowledge-pipeline": "node --test tests/knowledge-pipeline-obsidian-client.test.js tests/knowledge-pipeline-knowledge-gap-store.test.js tests/knowledge-pipeline-hermes-client.test.js tests/knowledge-pipeline-oem-and-practices.test.js tests/knowledge-pipeline-category-recommender.test.js tests/knowledge-pipeline-sku-and-catalog.test.js tests/knowledge-pipeline-e2e-http.test.js",
    "test": "npm run catalog:governance:test && npm run test:bot-protocol && npm run test:bot-e2e && npm run test:knowledge-governance && npm run test:knowledge-pipeline && npm run test:chatbot && npm run test:ebp",
    "hermes:catalogue:publication-plan": "node scripts/hermes/catalogue-publication-plan.mjs",
    "hermes:catalogue:publish-plan": "node scripts/hermes/publish-catalogue-plan.mjs",
    "hermes:catalogue:rollback": "node scripts/hermes/rollback-catalogue-publication.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "patchright": "^1.62.2",
    "pg": "^8.21.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
