{
  "name": "elimfilters-search-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-safe.js",
    "start": "node server-protocol.js",
    "dev": "node server-protocol.js",
    "build": "cd frontend && npm ci && npm run build",
    "hermes:validate": "node scripts/hermes/validate-candidates.mjs hermes/test-candidates",
    "hermes:report": "node scripts/hermes/generate-weekly-report.mjs hermes/test-candidates hermes/reports",
    "hermes:email": "node scripts/hermes/send-weekly-email.mjs hermes/reports",
    "hermes:decision": "node scripts/hermes/apply-review-decision.mjs",
    "hermes:publish": "node scripts/hermes/publish-approved-candidate.mjs",
    "hermes:phase1": "npm run hermes:validate && npm run hermes:report",
    "hermes:phase2": "npm run hermes:phase1 && npm run hermes:email",
    "test:ebp-phase1": "node --test tests/ebp-phase1/*.test.js",
    "test:ebp-phase2": "node --test tests/ebp-phase2/*.test.js",
    "test:ebp-phase3": "node --test tests/ebp-phase3/*.test.js",
    "test:ebp-phase4": "node --test tests/ebp-phase4/*.test.js",
    "test:ebp-phase5": "node --test tests/ebp-phase5/*.test.js",
    "test:ebp": "npm run test:ebp-phase1 && npm run test:ebp-phase2 && npm run test:ebp-phase3 && npm run test:ebp-phase4 && npm run test:ebp-phase5",
    "test:chatbot": "node --test tests/chatbot-routing-integration.test.js",
    "test:bot-protocol": "node --test tests/bot-protocol-guardrails.test.js tests/bot-protocol-final.test.js tests/bot-protocol-integration.test.js tests/bot-protocol-catalog-research.test.js tests/bot-protocol-state-consistency.test.js tests/bot-protocol-internal-audit.test.js",
    "test": "npm run test:bot-protocol && npm run test:chatbot && npm run test:ebp"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "exceljs": "^4.4.0",
    "multer": "^2.2.0"
  }
}
