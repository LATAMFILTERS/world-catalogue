    "hermes:registry:coverage": "node scripts/hermes/generate-source-coverage-report.mjs",
    "hermes:registry:discovery-backlog": "node scripts/hermes/generate-source-discovery-backlog.mjs",
    "hermes:preflight": "node scripts/hermes/operational-preflight.mjs",
    "hermes:baseline:restore": "node scripts/hermes/restore-baseline-from-state.mjs",
    "hermes:baseline:promote": "node scripts/hermes/promote-baseline.mjs",
    "hermes:baseline:rollback": "node scripts/hermes/rollback-baseline.mjs",
    "hermes:harvest:restore": "node scripts/hermes/sync-harvest-state.mjs restore",
    "hermes:harvest:persist": "node scripts/hermes/sync-harvest-state.mjs persist",
    "hermes:vault:sync": "node scripts/hermes/sync-vault.mjs",
    "hermes:vault:sync:apply": "node scripts/hermes/sync-vault.mjs --apply",
